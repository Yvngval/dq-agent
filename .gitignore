# Environnement
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env

# Données : la licence OpenSky interdit leur redistribution
data/
*.duckdb
*.duckdb.wal

# Artefacts dbt et journaux d'exécution (peuvent contenir des lignes de données)
dbt/target/
dbt/logs/
dbt/dbt_packages/
examples/*/dbt/target/
examples/*/dbt/logs/
examples/*/dbt/.user.yml
# Tests générés pendant les évaluations (dans un vrai projet, on les relit puis on les versionne)
dbt/tests/generated/
examples/*/dbt/tests/generated/
# Projets créés par `dq init`
projects/
logs/
reports/**/eval_run*.log
reports/weather/ci_results.jsonl
dbt/.user.yml
