# Copier en .env et adapter. Le fichier .env n'est jamais commité.

# Raisonneur par défaut : ollama (local), anthropic (API Claude) ou rules (sans LLM)
DQ_LLM_PROVIDER=ollama

# Ollama
OLLAMA_HOST=http://localhost:11434
DQ_OLLAMA_MODEL=qwen2.5-coder:7b

# Claude : la clé est lue par le SDK dans ANTHROPIC_API_KEY (ou un profil `ant auth login`)
# ANTHROPIC_API_KEY=
DQ_ANTHROPIC_MODEL=claude-opus-5-5
DQ_ANTHROPIC_EFFORT=low

# Garde-fous
DQ_MAX_AFFECTED_FRACTION=0.10
DQ_MAX_ATTEMPTS=3
